/*Challenge: Given an array of words, return the word that appears the most times.
['cat', 'dog', 'cat', 'bird', 'dog', 'cat'] → 'cat'*/
function MostAppearing(array){
    let maxCount = 0
    let result = ''
    let count = {}
    for(let i=0;i<array.length;i++){
        count[array[i]] = (count[array[i]] || 0) +1
    }
    for(let key in count){
        if(count[key]>maxCount){
            maxCount = count[key]
             result = key
        }
    }
    return result
}
console.log(MostAppearing(['dog','cat', 'dog', 'cat', 'bird', 'dog', 'cat']))
