//nums = [1,3,-1,-3,5,3,6,7],k=3
//output=[3,3,5,5,6,7]

function maxNum(nums,k){
    let result = []
for(let i=0;i<=nums.length-k;i++){
    let windowArray = []
    for(let j=i;j<i+k;j++){
        windowArray.push(nums[j])
    }
windowArray.sort((a,b)=>b-a)
result.push(windowArray[0])
}
return result
}
console.log(maxNum([1,3,-1,-3,5,3,6,7],3))
