function solution(numbers) {
const results = []
for(let i=0;i<=numbers.length-3;i++){
    let n1= numbers[i]
    let n2= numbers[i+1]
    let n3 = numbers[i+2]
    if((n2>n1 && n2>n3)||(n2<n1 && n2<n3)){
        results.push(1)
    } else {
        results.push(0)
    }
}
return results
}
console.log(solution([1, 2, 1, 3, 4]))
